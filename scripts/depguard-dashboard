#!/usr/bin/env python3
"""
DepGuard Security Score Dashboard Generator.
Generates a self-contained HTML dashboard from .depguard.json data.
No server, no dependencies — single HTML file. Open in any browser.

10/10 feature: Real-world deployability + impact visualization.
"""
from __future__ import annotations

import json
import sys
from datetime import datetime, timezone
from pathlib import Path


def load_depguard(path: Path) -> dict:
    if not path.exists():
        print(f"Error: {path} not found", file=sys.stderr)
        sys.exit(1)
    return json.loads(path.read_text())


def severity_color(severity: str) -> str:
    return {
        "CRITICAL": "#dc2626",
        "HIGH": "#ea580c",
        "MEDIUM": "#ca8a04",
        "LOW": "#2563eb",
    }.get(severity, "#6b7280")


def reachability_badge(verdict: str) -> str:
    badges = {
        "confirmed_reachable": '<span style="background:#dc2626;color:white;padding:2px 6px;border-radius:4px;font-size:11px">💥 CONFIRMED</span>',
        "reachable": '<span style="background:#ea580c;color:white;padding:2px 6px;border-radius:4px;font-size:11px">🔴 REACHABLE</span>',
        "likely_unreachable": '<span style="background:#caa8f;color:white;padding:2px 6px;border-radius:4px;font-size:11px">🟡 LIKELY SAFE</span>',
        "unreachable": '<span style="background:#16a34a;color:white;padding:2px 6px;border-radius:4px;font-size:11px">🟢 UNREACHABLE</span>',
    }
    return badges.get(verdict, f'<span style="background:#6b7280;color:white;padding:2px 6px;border-radius:4px;font-size:11px">❓ {verdict}</span>')


def generate(data: dict, output_path: Path) -> None:
    vulns = data.get("vulnerabilities", [])
    deps = data.get("dependencies", [])
    repos = data.get("repos", [])
    ra = data.get("reachability_analysis", {})

    total_vulns = len(vulns)
    critical = sum(1 for v in vulns if v.get("severity") == "CRITICAL")
    high = sum(1 for v in vulns if v.get("severity") == "HIGH")
    medium = sum(1 for v in vulns if v.get("severity") == "MEDIUM")
    reachable = sum(1 for v in vulns if v.get("reachability", {}).get("reachable"))
    confirmed = sum(1 for v in vulns if v.get("reachability", {}).get("poc_result") == "triggered")
    manual_review = len(data.get("manual_review", []))

    now = datetime.now(timezone.utc).strftime("%Y-%m-%d %H:%M:%S UTC")

    html = f"""<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>DepGuard — Security Dashboard</title>
<style>
* {{ margin: 0; padding: 0; box-sizing: border-box; }}
body {{ font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; background: #0f172a; color: #e2e8f0; padding: 2rem; }}
.header {{ text-align: center; margin-bottom: 2rem; }}
.header h1 {{ font-size: 2rem; color: #f8fafc; }}
.header p {{ color: #94a3b8; margin-top: 0.5rem; }}
.grid {{ display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; margin-bottom: 2rem; }}
.card {{ background: #1e293b; border-radius: 12px; padding: 1.5rem; text-align: center; }}
.card .value {{ font-size: 2.5rem; font-weight: 700; }}
.card .label {{ color: #94a3b8; margin-top: 0.5rem; font-size: 0.85rem; }}
.score-circle {{ width: 100px; height: 100px; border-radius: 50%; margin: 0 auto; display: flex; align-items: center; justify-content: center; font-size: 2rem; font-weight: 800; }}
.score-safe {{ background: #166534; border: 4px solid #22c55e; color: #22c55e; }}
.score-warn {{ background: #78350f; border: 4px solid #f97316; color: #f97316; }}
.score-danger {{ background: #7f1d1d; border: 4px solid #ef4444; color: #ef4444; }}
table {{ width: 100%; border-collapse: collapse; background: #1e293b; border-radius: 12px; overflow: hidden; }}
th {{ background: #334155; padding: 0.75rem 1rem; text-align: left; font-size: 0.8rem; text-transform: uppercase; color: #94a3b8; }}
td {{ padding: 0.75rem 1rem; border-bottom: 1px solid #334155; font-size: 0.9rem; }}
tr:hover {{ background: #334155; }}
.repo-tag {{ background: #3b82f6; color: white; padding: 2px 8px; border-radius: 4px; font-size: 0.75rem; }}
.fixed-tag {{ background: #166534; color: #22c55e; padding: 2px 8px; border-radius: 4px; font-size: 0.75rem; }}
.unfixed-tag {{ background: #78350f; color: #f97316; padding: 2px 8px; border-radius: 4px; font-size: 0.75rem; }}
.mtbf {{ grid-column: span 2; }}
@media (max-width: 768px) {{ .grid {{ grid-template-columns: 1fr; }} .mtbf {{ grid-column: span 1; }} }}
</style>
</head>
<body>
<div class="header">
  <h1>🔒 DepGuard Security Dashboard</h1>
  <p>Generated: {now} | Repos monitored: {len(repos)} | Dependencies tracked: {len(deps)}</p>
</div>

<div class="grid">
  <div class="card">
    <div class="value" style="color:{'#ef4444' if total_vulns > 0 else '#22c55e'}">{total_vulns}</div>
    <div class="label">Total Vulnerabilities</div>
  </div>
  <div class="card">
    <div class="value" style="color:#dc2626">{critical}</div>
    <div class="label">CRITICAL</div>
  </div>
  <div class="card">
    <div class="value" style="color:#ea580c">{high}</div>
    <div class="label">HIGH</div>
  </div>
  <div class="card">
    <div class="value" style="color:#ca8a04">{medium}</div>
    <div class="label">MEDIUM</div>
  </div>
  <div class="card">
    <div class="value" style="color:#22c55e">{reachable}</div>
    <div class="label">Reachable (verified)</div>
  </div>
  <div class="card">
    <div class="value" style="color:#ef4444">{confirmed}</div>
    <div class="label">PoC Confirmed 💥</div>
  </div>
  <div class="card mtbf">
    <div class="value" style="color:#3b82f6">{manual_review}</div>
    <div class="label">Needs Manual Review (with AI Correction Plans)</div>
  </div>
</div>
"""

    # Security score
    if critical > 0:
        score_class = "score-danger"
        score_text = "D"
    elif high > 0:
        score_class = "score-warn"
        score_text = "C"
    elif medium > 0:
        score_class = "score-warn"
        score_text = "B"
    else:
        score_class = "score-safe"
        score_text = "A"

    html += f"""
<div style="text-align:center; margin-bottom: 2rem;">
  <div class="score-circle {score_class}">{score_text}</div>
  <p style="color:#94a3b8; margin-top: 0.5rem;">Overall Security Grade</p>
</div>
"""

    # Vulnerability table
    if vulns:
        html += """
<h2 style="margin-bottom: 1rem;">📋 Vulnerability Details</h2>
<table>
<thead>
<tr><th>Repo</th><th>Package</th><th>Version</th><th>CVE</th><th>Severity</th><th>Reachability</th><th>Status</th></tr>
</thead>
<tbody>
"""
        for v in sorted(vulns, key=lambda x: ("CRITICAL,HIGH,MEDIUM,LOW".index(x.get("severity", "LOW")))):
            sev = v.get("severity", "?")
            ra_data = v.get("reachability", {})
            reach_badge = reachability_badge(ra_data.get("verdict", ""))
            action = v.get("action", "")
            status = '<span class="fixed-tag">AUTO-PATCH</span>' if action == "auto_patch" else '<span class="unfixed-tag">MANUAL REVIEW</span>'
            html += f"""<tr>
<td><span class="repo-tag">{v.get('repo', '?')}</span></td>
<td><strong>{v.get('package', '?')}</strong></td>
<td>{v.get('version', '?')}</td>
<td><code>{v.get('cve', '?')}</code></td>
<td style="color:{severity_color(sev)};font-weight:600">{sev}</td>
<td>{reach_badge}</td>
<td>{status}</td>
</tr>
"""
        html += "</tbody></table>"

    # Manual review with correction plans
    mr = data.get("manual_review", [])
    if mr:
        html += '<h2 style="margin: 2rem 0 1rem;">🛠️ Manual Review — AI Correction Plans</h2>'
        for item in mr:
            cp = item.get("correction_plan", {})
            if cp:
                root_cause = cp.get("root_cause", "Unknown")
                difficulty = cp.get("difficulty", "?")
                plan_steps = cp.get("correction_plan", [])
                confidence = cp.get("confidence", 0)
                html += f"""
<div style="background:#1e293b; border-radius:12px; padding:1rem; margin-bottom:1rem;">
  <strong>📦 {item.get('package', '?')}</strong> → <code>{item.get('cve', '?')}</code>
  <p style="color:#94a3b8; margin-top:0.5rem;">Root cause: {root_cause}</p>
  <p>Difficulty: <span style="color:{'#22c55e' if difficulty == 'TRIVIAL' else '#ea580c' if difficulty == 'MINOR' else '#dc2626'}">{difficulty}</span> (AI confidence: {confidence}%)</p>
  <ol style="margin:0.5rem 0 0 1.5rem; color:#e2e8f0;">
    {''.join(f'<li>{step}</li>' for step in plan_steps)}
  </ol>
</div>"""

    html += """
<div style="text-align:center; margin-top:3rem; padding:1rem; color:#475569; font-size:0.8rem;">
  Generated by DepGuard Agent • Hermes Agent Runtime • OpenClaw Agenthon 2026
</div>
</body></html>"""

    output_path.write_text(html)
    print(f"✅ Dashboard generated: {output_path}")


def main():
    depguard_path = Path(sys.argv[1]) if len(sys.argv) > 1 else Path(".depguard.json")
    output_path = Path(sys.argv[2]) if len(sys.argv) > 2 else Path("/tmp/depguard-dashboard.html")

    data = load_depguard(depguard_path)
    generate(data, output_path)


if __name__ == "__main__":
    main()
