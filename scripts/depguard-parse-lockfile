#!/usr/bin/env python3
"""Emit dependency records from supported lockfiles as JSON Lines."""

from __future__ import annotations

import json
import re
import sys
from pathlib import Path


def emit(repo: str, ecosystem: str, name: str, version: str, manifest: Path, source: str) -> None:
    if not name:
        return
    print(
        json.dumps(
            {
                "repo": repo,
                "ecosystem": ecosystem,
                "name": name,
                "version": version or "",
                "manifest": str(manifest),
                "source": source,
            },
            sort_keys=True,
        )
    )


def parse_package_lock(path: Path, repo: str) -> None:
    data = json.loads(path.read_text())
    lockfile_version = int(data.get("lockfileVersion", 1))

    if lockfile_version >= 2 and isinstance(data.get("packages"), dict):
        for package_path, meta in data["packages"].items():
            if not package_path or not package_path.startswith("node_modules/"):
                continue
            name = package_path.removeprefix("node_modules/")
            if "/node_modules/" in name:
                name = name.rsplit("/node_modules/", 1)[1]
            emit(repo, "npm", name, meta.get("version", ""), path, "package-lock.packages")
        return

    for name, meta in data.get("dependencies", {}).items():
        emit(repo, "npm", name, meta.get("version", ""), path, "package-lock.dependencies")


def parse_poetry_lock(path: Path, repo: str) -> None:
    text = path.read_text()
    for block in re.split(r"\n(?=\[\[package\]\])", text):
        if "[[package]]" not in block:
            continue
        name = version = ""
        for raw in block.splitlines():
            line = raw.strip()
            if line.startswith("name = "):
                name = line.split("=", 1)[1].strip().strip('"')
            elif line.startswith("version = "):
                version = line.split("=", 1)[1].strip().strip('"')
        emit(repo, "PyPI", name, version, path, "poetry.lock")


def parse_cargo_lock(path: Path, repo: str) -> None:
    text = path.read_text()
    for block in re.split(r"\n(?=\[\[package\]\])", text):
        if "[[package]]" not in block:
            continue
        name = version = ""
        for raw in block.splitlines():
            line = raw.strip()
            if line.startswith("name = "):
                name = line.split("=", 1)[1].strip().strip('"')
            elif line.startswith("version = "):
                version = line.split("=", 1)[1].strip().strip('"')
        emit(repo, "crates.io", name, version, path, "Cargo.lock")


def parse_pipfile_lock(path: Path, repo: str) -> None:
    data = json.loads(path.read_text())
    for section in ("default", "develop"):
        for name, meta in data.get(section, {}).items():
            emit(repo, "PyPI", name, meta.get("version", ""), path, f"Pipfile.lock.{section}")


def main() -> int:
    if len(sys.argv) != 3:
        print("Usage: depguard-parse-lockfile LOCKFILE REPO", file=sys.stderr)
        return 2

    path = Path(sys.argv[1])
    repo = sys.argv[2]
    if not path.is_file():
        print(f"Error: lockfile not found: {path}", file=sys.stderr)
        return 1

    parsers = {
        "package-lock.json": parse_package_lock,
        "poetry.lock": parse_poetry_lock,
        "Cargo.lock": parse_cargo_lock,
        "Pipfile.lock": parse_pipfile_lock,
    }
    parser = parsers.get(path.name)
    if not parser:
        print(f"Error: unsupported lockfile: {path.name}", file=sys.stderr)
        return 2
    parser(path, repo)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
